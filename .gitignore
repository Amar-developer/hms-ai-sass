# Dependencies
node_modules/
backend/venv/
backend/.venv/


# Build outputs
.next/
.next*/
.next*
.next.permission-backup/
.next-permission-backup/
out/
dist/
build/
tmp/
.next-build/

# Test and tool caches
.pytest_cache/
.ruff_cache/
coverage/
.coverage
tsconfig.tsbuildinfo

# Auto-regenerated by `next dev`/`next build` on every run — never meant to
# be committed (this is Next.js's own default .gitignore entry). Tracking it
# means every `npm run build` (the pre-push quality gate) dirties the tree
# and trips pre-commit's "files were modified by this hook" failure.
frontend/next-env.d.ts
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.state/

# Python
__pycache__/
*.py[cod]

# Environment
.env
.env.*
# Keep only the safe templates in Git; never commit real secrets.
!.env.example
!.env.staging.example

# Local OS and database files
.DS_Store
*.db
*.sqlite
*.sqlite3

# Local editor and AI-assistant configuration
.claude/
.vscode/

# Temporary invoice design/debug artifacts
frontend/debug.png
frontend/small.pdf
frontend/_inspect_tmp.js

# Runtime uploads
uploads/
backend/uploads/
.deploy-backups/
