#!/bin/sh
set -eu

message_file="$1"
first_line="$(sed -n '1p' "$message_file")"

if [ "${#first_line}" -gt 90 ]; then
  echo "Commit subject is too long. Keep the first line under 90 characters."
  exit 1
fi

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|test|refactor|chore|ci|perf|style|build|revert)(\([a-z0-9._-]+\))?: .+'; then
  echo "Use Conventional Commit format:"
  echo "  feat(appointments): prevent duplicate patient slot booking"
  echo "  fix(queue): show doctor full name"
  echo "Allowed types: feat, fix, docs, test, refactor, chore, ci, perf, style, build, revert"
  exit 1
fi
