#!/bin/sh
set -eu

branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
  main|master|develop|development|production|release)
    echo "Direct commits to '$branch' are blocked."
    echo "Create a feature branch, for example: git checkout -b feature/appointment-token-fix"
    exit 1
    ;;
esac

if git diff --cached --name-only | grep -Eq '(^backend/app/|^backend/tests/|^backend/alembic/|^features/|^app/|^components/|^lib/|package.json|package-lock.json|requirements.*\.txt|pytest.ini|tsconfig.json)'; then
  echo "Running pre-commit quality gate..."

  if git diff --cached --name-only | grep -Eq '^backend/(app|tests)/.*\.py$'; then
    backend/.venv/bin/ruff check backend/app backend/tests
  fi

  if git diff --cached --name-only | grep -Eq '^(features|app|components|lib|__tests__)/.*\.(ts|tsx|js|jsx)$|^package(-lock)?\.json$|^tsconfig\.json$'; then
    npm test
  fi
fi

echo "Pre-commit checks passed."
