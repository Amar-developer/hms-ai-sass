# Frontend
NEXT_PUBLIC_MEDIZINHUB_API_URL=http://localhost:8000/api/v1

# Backend
MEDIZINHUB_APP_NAME=MedizinHub HMS API
MEDIZINHUB_APP_VERSION=0.1.0
MEDIZINHUB_ENVIRONMENT=local
MEDIZINHUB_API_PREFIX=/api/v1
MEDIZINHUB_ENABLE_DOCS=true

# SQLite quick-start option:
# MEDIZINHUB_DATABASE_URL=sqlite:///./medizinhub_hms.db

# PostgreSQL Docker Compose option:
MEDIZINHUB_DATABASE_URL=postgresql+psycopg://medizinhub:medizinhub_dev@localhost:5433/medizinhub_hms
MEDIZINHUB_REDIS_URL=redis://localhost:6379/0
