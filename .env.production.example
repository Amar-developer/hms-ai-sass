# Production template. Supply secrets through the deployment secret manager,
# not by committing a populated copy of this file.
NEXT_PUBLIC_MEDIZINHUB_API_URL=https://api.example.com/api/v1

MEDIZINHUB_APP_NAME=MedizinHub HMS API
MEDIZINHUB_ENVIRONMENT=production
MEDIZINHUB_BUILD_COMMIT=unknown
MEDIZINHUB_BUILD_TIME=
MEDIZINHUB_LOG_LEVEL=INFO
MEDIZINHUB_SLOW_REQUEST_MS=1000
MEDIZINHUB_API_PREFIX=/api/v1
MEDIZINHUB_ENABLE_DOCS=false
MEDIZINHUB_AUTO_CREATE_TABLES=false
MEDIZINHUB_MAX_UPLOAD_SIZE_MB=5
MEDIZINHUB_WEB_CONCURRENCY=2
MEDIZINHUB_WEB_LIMIT_CONCURRENCY=80
MEDIZINHUB_WEB_BACKLOG=2048
MEDIZINHUB_WEB_TIMEOUT_KEEP_ALIVE=5
MEDIZINHUB_WEB_GRACEFUL_SHUTDOWN_SECONDS=30
# Set to the exact load-balancer/reverse-proxy source addresses.
# Read by uvicorn itself, so this one is deliberately unprefixed.
FORWARDED_ALLOW_IPS=127.0.0.1

MEDIZINHUB_FILE_STORAGE_BACKEND=s3
MEDIZINHUB_AWS_S3_BUCKET=medizinhub-prod-documents
MEDIZINHUB_AWS_S3_REGION=ap-south-1
MEDIZINHUB_AWS_S3_PREFIX=
MEDIZINHUB_AWS_S3_ENDPOINT_URL=
MEDIZINHUB_AWS_S3_KMS_KEY_ID=
MEDIZINHUB_AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
MEDIZINHUB_PERMANENT_INVOICE_DELIVERY_ENABLED=false

# If deploying with the bundled docker-compose.yml, the `backend` and
# `report-worker` services override this to route through the `pgbouncer`
# service automatically — this value only matters for standalone deploys.
# In that case, point it at your own connection pooler (PgBouncer/RDS Proxy)
# in front of Postgres, not at Postgres directly: with multiple app
# workers/processes each holding their own pool, connecting straight to
# Postgres is what causes `QueuePool ... TimeoutError` under concurrent
# load once (workers × (pool_size + max_overflow)) approaches Postgres's
# max_connections.
# The database URL is assembled by the compose file, not set here, so a single
# place decides the topology. Override only the host if you need to bypass or
# introduce a pooler; leave unset to accept the compose file's default
# (pgbouncer for docker-compose.yml / .staging.yml, postgres for .local.yml).
# MEDIZINHUB_DB_HOST=pgbouncer
# MEDIZINHUB_MIGRATION_DB_HOST=postgres
# Direct PostgreSQL endpoint used only by the locked migration/readiness gate.
# Do not point this at PgBouncer transaction pooling.
# Per-process pool bounds against whatever MEDIZINHUB_DATABASE_URL points
# at. Keep modest when pointed at a pooler (it does the real pooling); only
# raise these if you also have headroom on the pooler/Postgres side.
MEDIZINHUB_DB_POOL_SIZE=10
MEDIZINHUB_DB_MAX_OVERFLOW=10
MEDIZINHUB_DB_POOL_TIMEOUT=5
MEDIZINHUB_DB_STATEMENT_TIMEOUT_MS=30000
MEDIZINHUB_DB_LOCK_TIMEOUT_MS=5000
MEDIZINHUB_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
MEDIZINHUB_DB_DISABLE_PREPARED_STATEMENTS=true
MEDIZINHUB_REDIS_URL=redis://HOST:6379/0
# How long tenant status and per-user permission/role lookups are cached in
# Redis on the auth hot path. 0 disables caching. Bounds worst-case
# staleness of a revoked permission or a just-suspended tenant.
MEDIZINHUB_AUTH_CACHE_TTL_SECONDS=30
MEDIZINHUB_LOGIN_RATE_LIMIT_ATTEMPTS=10
MEDIZINHUB_LOGIN_RATE_LIMIT_IP_ATTEMPTS=50
MEDIZINHUB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
MEDIZINHUB_SECURE_COOKIE=true
MEDIZINHUB_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-secret-characters
# One-time tenant bootstrap is disabled unless an operator supplies this secret.
# Store the real value in the production secret manager and rotate it after use.
MEDIZINHUB_BOOTSTRAP_TOKEN=replace-with-a-production-bootstrap-secret
MEDIZINHUB_CORS_ORIGINS=["https://app.example.com"]

# Required by the bundled docker-compose.yml (postgres, pgbouncer, backend,
# report-worker services all reference these — see MEDIZINHUB_DATABASE_URL
# and MEDIZINHUB_MIGRATION_DATABASE_URL comments above).
POSTGRES_DB=medizinhub_hms
POSTGRES_USER=medizinhub
POSTGRES_PASSWORD=replace-with-a-strong-production-password

# Bundled PostgreSQL/PgBouncer capacity. Managed services should configure the
# equivalent limits in their own control plane.
POSTGRES_MAX_CONNECTIONS=100
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5
# Bounds how long a client waits for a server connection. PgBouncer's default
# is 120s, which disables the API's 503 + Retry-After load shedding: saturation
# then presents as a hang rather than a fast, counted failure. Reserve
# connections are released to clients that have already waited
# RESERVE_POOL_TIMEOUT seconds, so brief bursts borrow capacity. Effective
# server connections per pool = DEFAULT_POOL_SIZE + RESERVE_POOL_SIZE.
PGBOUNCER_QUERY_WAIT_TIMEOUT=10
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

MEDIZINHUB_REPORT_QUEUE_NAME=medizinhub:reports:monthly
MEDIZINHUB_REPORT_SCHEDULER_LOCK_KEY=medizinhub:reports:monthly:scheduler
MEDIZINHUB_REPORT_WORKER_HEARTBEAT_KEY=medizinhub:workers:reports:heartbeat
MEDIZINHUB_REPORT_WORKER_HEARTBEAT_TTL_SECONDS=30
MEDIZINHUB_REPORT_QUEUE_DEDUPE_TTL_SECONDS=60
MEDIZINHUB_REPORT_JOB_STALE_AFTER_SECONDS=900
# Required for SMS delivery receipts; use the API origin without /api/v1.
MEDIZINHUB_PUBLIC_API_BASE_URL=https://api.example.com
MEDIZINHUB_SMS_WORKER_BATCH_LIMIT=10

# External medicine catalog GraphQL provider used when the tenant medicine plugin is enabled.
MEDIZINHUB_MEDICINE_GRAPHQL_URL=https://www.medizinhub.com/graphql
MEDIZINHUB_MEDICINE_GRAPHQL_TIMEOUT_SECONDS=10

MEDIZINHUB_SMTP_HOST=
MEDIZINHUB_SMTP_PORT=587
MEDIZINHUB_SMTP_USERNAME=
MEDIZINHUB_SMTP_PASSWORD=
MEDIZINHUB_SMTP_FROM_EMAIL=reports@example.com
MEDIZINHUB_SMTP_FROM_NAME=MedizinHub HMS Reports
MEDIZINHUB_SMTP_USE_TLS=true

# --- Operational overrides (defaults are usually correct) ---
# Where uploaded files are written when file_storage_backend=local.
MEDIZINHUB_UPLOADS_DIR=/data/uploads
# Worker thread ceiling per web process.
MEDIZINHUB_WEB_THREAD_LIMIT=40
# Days a finished month stays editable before its snapshot is frozen.
MEDIZINHUB_REPORT_SNAPSHOT_GRACE_DAYS=3
# Leave blank to derive from the environment (live only in production).
# Set to true to send real WhatsApp messages from a non-production stack.
MEDIZINHUB_WHATSAPP_LIVE_DELIVERY=
