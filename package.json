{
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --cache=false",
    "quality": "npm run quality:backend && npm run quality:frontend",
    "quality:backend": "backend/.venv/bin/ruff check backend/app backend/tests && backend/.venv/bin/pytest backend/tests -q",
    "quality:frontend": "npm test && npm run build",
    "hooks:install": "sh scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "14.2.16",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
